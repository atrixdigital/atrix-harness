{
  "description": "Atrix harness — safety guard, trace recorder, session context.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-destructive.ts\" \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/record-trace.ts\" \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.ts\" \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
